# =============================================================================
# Букля — настройки. Скопируйте в .env и заполните.
# =============================================================================

# ----------------------------------------------------------------------------- Docker
# Какие контейнеры запускает `docker compose up`: telegram, vk или all (+ postgres)
COMPOSE_PROFILES=all

# ----------------------------------------------------------------------------- без Docker
# Какие боты запускает `python -m buklya` в одном процессе: telegram, vk или all.
# Пусто — все, для которых задан токен. Аргумент важнее: python -m buklya vk
BOTS=

# ----------------------------------------------------------------------------- Telegram
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Telegram ID через запятую, кому можно пользоваться ботом (пусто — всем)
TELEGRAM_ALLOWED_USERS=

# ----------------------------------------------------------------------------- ВКонтакте
# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа.
# Права: управление сообществом (обязательно для Long Poll), сообщения сообщества,
# документы, фотографии.
VK_TOKEN=
# ID сообщества (без минуса). Необязательно — определяется по ключу.
VK_GROUP_ID=
# ID пользователей ВКонтакте через запятую, кому можно пользоваться ботом (пусто — всем)
VK_ALLOWED_USERS=

# ----------------------------------------------------------------------------- безопасность
# Мастер-ключ шифрования учётных данных. Сгенерировать: python -m buklya.crypto
# Все контейнеры ботов работают с одной базой и должны использовать ОДИН И ТОТ ЖЕ ключ.
ENCRYPTION_KEY=
# Старые ключи через запятую (для ротации)
OLD_ENCRYPTION_KEYS=

# ----------------------------------------------------------------------------- база данных
DATABASE_URL=sqlite+aiosqlite:///data/buklya.db
# DATABASE_URL=postgresql+asyncpg://buklya:buklya@postgres:5432/buklya
DATABASE_ECHO=false

# ----------------------------------------------------------------------------- почта
POLL_INTERVAL=60
POLL_CONCURRENCY=5
MAIL_TIMEOUT=30
LAST_MESSAGES_COUNT=10
MAX_ATTACHMENT_SIZE=51380224
ATTACH_HTML_ORIGINAL=true

# ----------------------------------------------------------------------------- связка мессенджеров
# Сколько минут действует код /link
LINK_CODE_TTL_MINUTES=10

# ----------------------------------------------------------------------------- тексты
# Язык: файл locales/<язык>.yaml
LOCALE=ru

# ----------------------------------------------------------------------------- логирование
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
# Цвет в консоли: auto (если консоль поддерживает), true, false. В файлах цвета нет.
LOG_COLOR=auto
